generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: conexão pooled do Neon (com -pooler).
  url      = env("DATABASE_URL")
  // Migrações: conexão DIRETA (sem -pooler). O advisory lock do prisma migrate
  // não sobrevive ao PgBouncer da pooled e estoura P1002.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Acesso ───────────────────────────

model Usuario {
  id                 String   @id @default(uuid()) @db.Uuid
  nome               String
  email              String   @unique
  senhaHash          String   @map("senha_hash")
  papelId            String?  @map("papel_id") @db.Uuid
  ativo              Boolean  @default(true)
  // senha provisória: admin criou/resetou → o próximo login exige senha nova
  precisaTrocarSenha Boolean  @default(false) @map("precisa_trocar_senha")
  criadoEm           DateTime @default(now()) @map("criado_em")

  papel        Papel?       @relation(fields: [papelId], references: [id])
  // um usuário pode estar amarrado a um responsável da produção (o Oleiro tem login)
  responsavel  Responsavel?

  @@map("usuarios")
}

model Papel {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String   @unique
  admin      Boolean  @default(false)
  // protegido = não pode ser apagado pela tela (gestao/producao/leitura)
  protegido  Boolean  @default(false)
  permissoes Json
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuarios Usuario[]

  @@map("papeis")
}

/// MÓDULO DESLIGADO — uma linha por módulo, e não um JSON com a lista.
///
/// A leitura é "está desligado só se existe uma linha dizendo que está". É essa
/// forma, e não o conteúdo, que resolve o pedido "sempre que adicionarmos":
/// módulo novo nasce sem linha nenhuma e, por isso, nasce LIGADO — ninguém
/// precisa lembrar de acrescentá-lo em lugar algum no dia do deploy.
///
/// Um campo JSON com `{ desligados: [...] }` faria o contrário: a lista gravada
/// ontem não conhece o módulo de amanhã, e a cada release alguém teria de
/// migrar o JSON para o módulo novo aparecer. Fora que duas telas salvando o
/// mesmo JSON sobrescrevem uma à outra; aqui cada módulo é uma linha própria.
///
/// Desligar NÃO apaga dado e NÃO desliga cálculo: só some do menu e barra a
/// rota. Religar devolve tudo como estava, que é o combinado com o ateliê.
model ModuloAtivo {
  /// a mesma chave de src/lib/modulos.ts — é o que amarra a linha ao registro
  chave String  @id
  ativo Boolean @default(true)

  @@map("modulos_ativos")
}

model LogAtividade {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuarioNome String   @map("usuario_nome")
  metodo      String
  recurso     String
  caminho     String
  entidadeId  String?  @map("entidade_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("logs_atividade")
}

// ─────────────────────────── Cadastros ───────────────────────────

model Categoria {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String   @unique
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  pecas Peca[]

  @@map("categorias")
}

/// Esmalte. O `hex` serve pro chip na interface, mas esmalte malhado
/// (Branco vs. Pedra Sabão têm praticamente a MESMA cor média) só se
/// distingue pela foto — por isso `amostraUrl` e `malhado` existem.
model Cor {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String   @unique
  nomeBusca  String   @default("") @map("nome_busca")
  hex        String   @default("#CCCCCC")
  amostraUrl String?  @map("amostra_url")
  malhado    Boolean  @default(false)
  observacao String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  pecas      PecaCor[]
  lotes      Lote[]
  movimentos MovimentoLote[]
  insumos    PecaInsumo[]
  vendas     Venda[]
  itensEncomenda EncomendaItem[]

  @@map("cores")
}

model Responsavel {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @unique
  nomeBusca String   @default("") @map("nome_busca")
  /// pessoa | equipe | forno
  tipo      String   @default("pessoa")
  cor       String   @default("#BBA58C")
  /// peças/dia — base da meta diária com saldo rolante (o que sobra
  /// de hoje soma amanhã; o que passou da meta abate do dia seguinte)
  capacidadeDiaria Int? @map("capacidade_diaria")
  /// Só para `tipo = forno`: quantas peças cabem em UMA fornada.
  /// Não é capacidade por dia — forno não trabalha por dia, trabalha por
  /// carga. Uma peça não espera o forno, espera o forno encher.
  capacidadeCarga  Int? @map("capacidade_carga")
  /// Só para `tipo = forno`: horas do fechar a porta ao poder abrir,
  /// já contando o resfriamento. Ninguém abre forno antes: trinca.
  horasPorQueima   Int? @map("horas_por_queima")
  /// login opcional: o Oleiro abre o app e vê só a fila dele
  usuarioId String?  @unique @map("usuario_id") @db.Uuid
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario       Usuario?       @relation(fields: [usuarioId], references: [id])
  etapasPadrao  Etapa[]
  roteiros      RoteiroEtapa[]
  pecasIniciais Peca[]          @relation("responsavelInicial")
  movimentos    MovimentoLote[]
  folgas        Folga[]
  queimas       Queima[]

  @@map("responsaveis")
}

/// Dia em que o responsável não trabalha.
///
/// Sem isto, o saldo rolante da agenda transforma folga em dívida: o oleiro
/// falta na quarta e a meta de quinta fica impossível. O reset de segunda foi
/// feito exatamente para dívida não se acumular — folga é o mesmo problema
/// dentro da semana.
model Folga {
  id            String   @id @default(uuid()) @db.Uuid
  responsavelId String   @map("responsavel_id") @db.Uuid
  /// dia cheio, sem hora — comparado por data no fuso de São Paulo
  data          DateTime @db.Date
  /// folga | feriado | atestado | outro
  motivo        String   @default("folga")
  observacao    String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  responsavel Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)

  @@unique([responsavelId, data])
  @@index([data])
  @@map("folgas")
}

model Etapa {
  id                  String   @id @default(uuid()) @db.Uuid
  nome                String   @unique
  /// producao | secagem | queima | estoque | final | segunda | foto
  ///
  /// `segunda` é destino terminal, como `final`: peça com defeito pequeno que
  /// vende com desconto. Jogar isso em perda faz três estragos ao mesmo tempo
  /// — some com estoque que existe, infla a taxa de perda e por ela contamina
  /// o custo (lib/precificacao.ts usa a perda medida).
  tipo                String   @default("producao")
  ordemPadrao         Int      @default(0) @map("ordem_padrao")
  /// Etapa que só anda quando o forno enche. O lote não espera a etapa,
  /// espera a carga fechar — é o que a previsão de data precisa saber para
  /// não prometer data que o ateliê não cumpre.
  aguardaCarga        Boolean  @default(false) @map("aguarda_carga")
  /// etapa em que a cor do lote é decidida (Esmaltação).
  /// Antes dela o lote não tem cor — é biscoito neutro.
  defineCor           Boolean  @default(false) @map("define_cor")
  /// etapa que representa estoque parado (Biscoito) — o lote pode ficar aqui
  /// indefinidamente até a demanda dizer de que cor ele vai ser
  estoqueIntermediario Boolean @default(false) @map("estoque_intermediario")
  /// Quantas peças cabem numa carga desta queima.
  ///
  /// Mora na ETAPA, e não num responsável do tipo forno, porque é dela que a
  /// pergunta é feita: "cabe mais nesta queima?". O ateliê tem um forno para a
  /// 1ª e outro para a 2ª, de tamanhos diferentes, e amarrar a capacidade à
  /// etapa é o que permite os dois números coexistirem sem ninguém escolher
  /// "a capacidade do ateliê". Antes isso era um Responsavel de mentira, que
  /// aparecia junto com gente na tela de Responsáveis e nunca teve campo.
  capacidadeCarga     Int?     @map("capacidade_carga")
  /// Quanto tempo a carga ocupa o forno, de aquecer a esfriar.
  horasPorQueima      Int?     @map("horas_por_queima")
  responsavelPadraoId String?  @map("responsavel_padrao_id") @db.Uuid
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em")

  responsavelPadrao   Responsavel?    @relation(fields: [responsavelPadraoId], references: [id])
  roteiros            RoteiroEtapa[]
  movimentosOrigem    MovimentoLote[] @relation("movOrigem")
  movimentosDestino   MovimentoLote[] @relation("movDestino")
  itensDeQueima       QueimaItem[]
  insumos             PecaInsumo[]

  @@map("etapas")
}

model Peca {
  id                   String   @id @default(uuid()) @db.Uuid
  nome                 String   @unique
  nomeBusca            String   @default("") @map("nome_busca")
  categoriaId          String   @map("categoria_id") @db.Uuid
  responsavelInicialId String?  @map("responsavel_inicial_id") @db.Uuid
  /// dias do início ao "Pronto" (a loja anuncia ~30 dias)
  tempoMedioDias       Int      @default(30) @map("tempo_medio_dias")
  /// mínimo desejado de peças PRONTAS (somando todas as cores)
  qtdMinimaDesejada    Int      @default(0) @map("qtd_minima_desejada")
  /// mínimo desejado em BISCOITO — o pulmão que permite atender
  /// uma cor que saiu bem sem começar tudo do zero
  qtdMinimaBiscoito    Int      @default(0) @map("qtd_minima_biscoito")
  precoBase            Decimal? @map("preco_base") @db.Decimal(10, 2)

  /// ─────────────── FICHA TÉCNICA ───────────────
  /// O padrão a ser seguido ao reproduzir a peça. Pedido do João: sem isto,
  /// cada pessoa reproduz de memória e a diferença só aparece quando as peças
  /// estão lado a lado na prateleira.
  ///
  /// Tudo opcional: peça antiga não tem medida, e obrigar a preencher travaria
  /// o cadastro de quem só quer registrar uma peça nova. Nulo aqui quer dizer
  /// "ninguém definiu ainda", e a tela diz isso em vez de mostrar zero.
  alturaCm             Decimal? @map("altura_cm") @db.Decimal(6, 1)
  /// diâmetro na peça redonda, largura na que não é
  larguraCm            Decimal? @map("largura_cm") @db.Decimal(6, 1)
  /// só faz sentido em peça que contém líquido (xícara, bowl, jarra)
  capacidadeMl         Int?     @map("capacidade_ml")
  /// peso do barro antes de secar — é o que o oleiro pesa na hora de tornear
  pesoCruG             Int?     @map("peso_cru_g")
  /// `cru` | `pronto` — a argila ENCOLHE na queima, então a mesma peça mede
  /// diferente antes e depois do forno. Sem registrar o momento, a medida não
  /// serve para conferir nada.
  medidasMomento       String?  @map("medidas_momento")
  /// margem aceitável, em %. Peça artesanal não sai idêntica: sem tolerância a
  /// ficha vira número exato que nenhuma peça cumpre, e a equipe ignora o campo
  medidaToleranciaPct  Decimal? @map("medida_tolerancia_pct") @db.Decimal(4, 1)

  observacao           String?
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em")

  categoria          Categoria      @relation(fields: [categoriaId], references: [id])
  responsavelInicial Responsavel?   @relation("responsavelInicial", fields: [responsavelInicialId], references: [id])
  roteiro            RoteiroEtapa[]
  cores              PecaCor[]
  lotes              Lote[]
  custo              CustoPeca?
  insumos            PecaInsumo[]
  vendas             Venda[]
  itensEncomenda     EncomendaItem[]

  @@index([categoriaId])
  @@map("pecas")
}

/// Quanto de cada insumo uma peça consome.
///
/// Sem isto, "comprar esmalte" só dispara quando o estoque JÁ está baixo —
/// reação, não previsão. Esmalte tem prazo de entrega; descobrir a falta no
/// dia da esmaltação é tarde. Com o consumo, a compra vira
/// "o plano do mês pede 14 kg de Pistache e há 1,2 kg".
model PecaInsumo {
  id             String  @id @default(uuid()) @db.Uuid
  pecaId         String  @map("peca_id") @db.Uuid
  materiaPrimaId String  @map("materia_prima_id") @db.Uuid
  /// na unidade da matéria-prima (kg, g, un)
  quantidadePorPeca Decimal @map("quantidade_por_peca") @db.Decimal(12, 4)
  /// quando o insumo é consumido — serve para saber se a compra é urgente
  /// (esmalte gasto na esmaltação) ou pode esperar (argila, gasta no início)
  etapaId        String? @map("etapa_id") @db.Uuid
  /// insumo que só vale para uma cor: esmalte Pistache só sai em lote Pistache
  corId          String? @map("cor_id") @db.Uuid

  peca         Peca         @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  materiaPrima MateriaPrima @relation(fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  etapa        Etapa?       @relation(fields: [etapaId], references: [id])
  cor          Cor?         @relation(fields: [corId], references: [id])

  @@unique([pecaId, materiaPrimaId, corId])
  @@index([materiaPrimaId])
  @@map("peca_insumos")
}

/// O fluxo próprio de cada peça. A Xícara Bojudinha passa por alças e
/// colagem; a Tortinha vai direto da equipe pra secagem.
model RoteiroEtapa {
  id            String @id @default(uuid()) @db.Uuid
  pecaId        String @map("peca_id") @db.Uuid
  etapaId       String @map("etapa_id") @db.Uuid
  ordem         Int
  responsavelId String? @map("responsavel_id") @db.Uuid
  diasEstimados Int    @default(1) @map("dias_estimados")

  peca        Peca         @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  etapa       Etapa        @relation(fields: [etapaId], references: [id])
  responsavel Responsavel? @relation(fields: [responsavelId], references: [id])

  @@unique([pecaId, ordem])
  @@index([pecaId])
  @@map("roteiro_etapas")
}

/// Quais esmaltes existem para a peça, e o mínimo desejado por cor.
model PecaCor {
  id                String  @id @default(uuid()) @db.Uuid
  pecaId            String  @map("peca_id") @db.Uuid
  corId             String  @map("cor_id") @db.Uuid
  qtdMinimaDesejada Int     @default(0) @map("qtd_minima_desejada")
  ativo             Boolean @default(true)

  /*
   * O CICLO DA FOTO — a etapa de produção que ninguém tinha visto.
   *
   * Peça pronta sem foto não é peça vendável. O quadro mostrava tudo verde em
   * "Pronto" enquanto a peça não estava anunciada em lugar nenhum. Com a Gabi
   * na Espanha isso deixa de ser "ela faz depois" e vira fila com fuso no meio.
   *
   * A granularidade certa é AQUI, em peça+cor, e não no lote: um Bowl Pistache
   * fotografado uma vez serve toda fornada futura. O que precisa de foto nova
   * é combinação que nunca existiu.
   */
  /// pendente | fotografado | enviado | editado | publicado
  fotoStatus        String  @default("pendente") @map("foto_status")
  fotoUrl           String? @map("foto_url")
  fotoObservacao    String? @map("foto_observacao")
  fotoAtualizadaEm  DateTime? @map("foto_atualizada_em")

  peca Peca @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  cor  Cor  @relation(fields: [corId], references: [id])

  @@unique([pecaId, corId])
  @@index([fotoStatus])
  @@map("peca_cores")
}

/// O planejamento avisa quando cai abaixo do mínimo. O consumo automático
/// por lote ainda não existe: a baixa é manual.
model MateriaPrima {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @unique
  nomeBusca     String   @default("") @map("nome_busca")
  /// argila | esmalte | oxido | embalagem | outro
  tipo          String   @default("esmalte")
  unidade       String   @default("kg")
  estoqueAtual  Decimal  @default(0) @map("estoque_atual") @db.Decimal(10, 3)
  estoqueMinimo Decimal  @default(0) @map("estoque_minimo") @db.Decimal(10, 3)
  fornecedor    String?
  /// dias entre pedir e receber — sem isto a compra "urgente" chega tarde
  prazoEntregaDias Int   @default(7) @map("prazo_entrega_dias")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")

  insumos PecaInsumo[]

  @@map("materias_primas")
}

// ═══════════════════════ Fase 3 — Produção ═══════════════════════

/// Um lote é um conjunto de peças iguais andando junto pelo roteiro.
///
/// O lote NÃO tem "etapa atual": a movimentação é parcial (30 peças avançam,
/// 20 ficam), então o que existe é SALDO POR ETAPA, derivado dos movimentos.
/// Ver `saldosPorEtapa()` em lote.service.ts.
///
/// `corId` nasce nulo. A cor só é atribuída na etapa que tem `defineCor`,
/// que na prática acontece depois da 1ª queima — é assim que o ateliê
/// trabalha e é o que permite o biscoito ser estoque neutro.
model Lote {
  id           String    @id @default(uuid()) @db.Uuid
  /// código legível curto pra falar em voz alta no ateliê: L-0042
  codigo       String    @unique
  pecaId       String    @map("peca_id") @db.Uuid
  corId        String?   @map("cor_id") @db.Uuid
  quantidadeInicial Int  @map("quantidade_inicial")
  /// planejamento | manual | divisao | encomenda
  origem       String    @default("manual")
  loteOrigemId String?   @map("lote_origem_id") @db.Uuid
  /// quando o lote existe por causa de uma encomenda, ele herda o prazo dela
  /// e passa na frente da produção de estoque no planejamento
  encomendaId  String?   @map("encomenda_id") @db.Uuid
  observacao   String?
  iniciadoEm   DateTime  @default(now()) @map("iniciado_em")
  concluidoEm  DateTime? @map("concluido_em")
  canceladoEm  DateTime? @map("cancelado_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  peca        Peca            @relation(fields: [pecaId], references: [id])
  cor         Cor?            @relation(fields: [corId], references: [id])
  loteOrigem  Lote?           @relation("divisao", fields: [loteOrigemId], references: [id])
  divisoes    Lote[]          @relation("divisao")
  movimentos  MovimentoLote[]
  encomenda   Encomenda?      @relation(fields: [encomendaId], references: [id])
  queimas     QueimaItem[]

  @@index([pecaId])
  @@index([corId])
  @@index([encomendaId])
  @@map("lotes")
}

/// Livro-razão da produção. Nada é editado: erro se corrige com um
/// movimento de estorno, e o histórico continua contando a verdade.
///
/// etapaOrigemId nulo  = entrada do lote no sistema
/// etapaDestinoId nulo = saída definitiva (perda ou divisão para outro lote)
model MovimentoLote {
  id             String   @id @default(uuid()) @db.Uuid
  loteId         String   @map("lote_id") @db.Uuid
  etapaOrigemId  String?  @map("etapa_origem_id") @db.Uuid
  etapaDestinoId String?  @map("etapa_destino_id") @db.Uuid
  quantidade     Int
  /// inicio | avanco | perda | segunda | divisao_saida | divisao_entrada | estorno
  tipo           String
  /// preenchido quando o movimento passa pela etapa que define a cor
  corId          String?  @map("cor_id") @db.Uuid
  responsavelId  String?  @map("responsavel_id") @db.Uuid
  motivo         String?
  /// MOTIVO TIPADO DA PERDA — o que faz a perda somar e filtrar.
  ///
  /// `motivo` continua sendo o relato escrito, e é ele que faz o histórico
  /// valer meses depois. Mas texto livre não agrupa: dava para saber QUANTO se
  /// perde, nunca POR QUÊ — e a perda medida já alimenta em silêncio o quanto
  /// produzir e o custo real por peça. Valores válidos em lib/motivos-perda.ts.
  ///
  /// Opcional porque nulo é caso legítimo, não falta de dado: toda perda
  /// gravada antes desta coluna existir fica nula para sempre e aparece como
  /// "não informado". Preencher isso por trás seria inventar diagnóstico.
  motivoTipo     String?  @map("motivo_tipo")
  usuarioId      String?  @map("usuario_id") @db.Uuid
  usuarioNome    String   @map("usuario_nome")
  /*
   * Chave que o CLIENTE gera antes de mandar o movimento.
   *
   * O app é PWA e o ateliê tem sinal ruim: o oleiro registra 40 peças, a
   * requisição sai, o sinal cai antes da resposta voltar, a fila local
   * reenvia. Sem esta chave o reenvio grava 80. E num livro-razão
   * append-only, movimento duplicado não se apaga — se corrige com estorno,
   * o que suja o histórico para sempre.
   */
  chaveIdempotencia String? @unique @map("chave_idempotencia")
  criadoEm       DateTime @default(now()) @map("criado_em")

  lote         Lote         @relation(fields: [loteId], references: [id], onDelete: Cascade)
  etapaOrigem  Etapa?       @relation("movOrigem", fields: [etapaOrigemId], references: [id])
  etapaDestino Etapa?       @relation("movDestino", fields: [etapaDestinoId], references: [id])
  cor          Cor?         @relation(fields: [corId], references: [id])
  responsavel  Responsavel? @relation(fields: [responsavelId], references: [id])

  @@index([loteId])
  @@index([criadoEm])
  @@index([responsavelId, criadoEm])
  // o histórico filtra por "perda com este motivo" varrendo o livro-razão
  // inteiro; sem este índice a consulta cresce junto com todo movimento que o
  // ateliê registrar, e não só com as perdas
  @@index([tipo, motivoTipo])
  @@map("movimentos_lote")
}

/// Numerador do código do lote. Uma linha só, travada por UPDATE — sequence
/// do Postgres pularia números em rollback e o código ficaria feio na parede.
model Contador {
  nome  String @id
  valor Int    @default(0)

  @@map("contadores")
}

// ═══════════════════════ Fase 4 — Precificação ═══════════════════════

/// Canal de venda com as taxas que corroem a margem. Tudo é editável porque
/// marketplace muda comissão sem avisar.
model CanalVenda {
  id                     String   @id @default(uuid()) @db.Uuid
  nome                   String   @unique
  /// comissão do canal sobre o preço de venda
  comissaoPercentual     Decimal  @default(0) @map("comissao_percentual") @db.Decimal(6, 3)
  /// taxa fixa por pedido (o que mata a margem em peça barata)
  taxaFixa               Decimal  @default(0) @map("taxa_fixa") @db.Decimal(10, 2)
  /// frete que o vendedor banca
  freteSubsidiado        Decimal  @default(0) @map("frete_subsidiado") @db.Decimal(10, 2)
  /// investimento em anúncios, como % do preço
  percentualAds          Decimal  @default(0) @map("percentual_ads") @db.Decimal(6, 3)
  /// imposto sobre a venda (Simples, MEI…)
  percentualImposto      Decimal  @default(0) @map("percentual_imposto") @db.Decimal(6, 3)
  /// antecipação de recebível, se usar
  percentualAntecipacao  Decimal  @default(0) @map("percentual_antecipacao") @db.Decimal(6, 3)
  /// margem de lucro alvo sobre o custo
  margemAlvoPercentual   Decimal  @default(100) @map("margem_alvo_percentual") @db.Decimal(6, 3)
  moeda                  String   @default("BRL")
  observacao             String?
  ativo                  Boolean  @default(true)
  ordem                  Int      @default(0)
  criadoEm               DateTime @default(now()) @map("criado_em")

  precos PrecoCanal[]
  faixas FaixaTaxaCanal[]

  vendas Venda[]

  @@map("canais_venda")
}

/// Custo direto de uma peça. Mão de obra entra como minutos × custo/hora
/// porque é assim que dá pra conversar com a Vera sobre onde dói.
model CustoPeca {
  id                 String   @id @default(uuid()) @db.Uuid
  pecaId             String   @unique @map("peca_id") @db.Uuid
  custoArgila        Decimal  @default(0) @map("custo_argila") @db.Decimal(10, 2)
  custoEsmalte       Decimal  @default(0) @map("custo_esmalte") @db.Decimal(10, 2)
  custoQueima        Decimal  @default(0) @map("custo_queima") @db.Decimal(10, 2)
  custoEmbalagem     Decimal  @default(0) @map("custo_embalagem") @db.Decimal(10, 2)
  minutosMaoDeObra   Int      @default(0) @map("minutos_mao_de_obra")
  custoHoraMaoDeObra Decimal  @default(0) @map("custo_hora_mao_de_obra") @db.Decimal(10, 2)
  outrosCustos       Decimal  @default(0) @map("outros_custos") @db.Decimal(10, 2)
  /// perda usada enquanto não há histórico suficiente; o sistema prefere a real
  perdaEstimadaPercentual Decimal @default(10) @map("perda_estimada_percentual") @db.Decimal(6, 3)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  peca   Peca         @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  precos PrecoCanal[]

  @@map("custos_peca")
}

/// Preço praticado de uma peça num canal. Guardado para comparar com o
/// sugerido — é aí que aparece a peça que está sendo vendida no prejuízo.
model PrecoCanal {
  id           String   @id @default(uuid()) @db.Uuid
  custoPecaId  String   @map("custo_peca_id") @db.Uuid
  canalId      String   @map("canal_id") @db.Uuid
  precoAtual   Decimal? @map("preco_atual") @db.Decimal(10, 2)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  custoPeca CustoPeca  @relation(fields: [custoPecaId], references: [id], onDelete: Cascade)
  canal     CanalVenda @relation(fields: [canalId], references: [id], onDelete: Cascade)

  @@unique([custoPecaId, canalId])
  @@map("precos_canal")
}

/// Faixa de preço com taxa própria. Shopee e Mercado Livre cobram diferente
/// conforme o valor do produto — e as peças da VF (R$49 a R$283) atravessam
/// justamente as faixas onde a regra muda. Um percentual único erraria a conta
/// exatamente na parte do catálogo que mais importa.
model FaixaTaxaCanal {
  id                 String   @id @default(uuid()) @db.Uuid
  canalId            String   @map("canal_id") @db.Uuid
  valorMinimo        Decimal  @map("valor_minimo") @db.Decimal(10, 2)
  /// nulo = sem teto
  valorMaximo        Decimal? @map("valor_maximo") @db.Decimal(10, 2)
  comissaoPercentual Decimal  @map("comissao_percentual") @db.Decimal(6, 3)
  taxaFixa           Decimal  @default(0) @map("taxa_fixa") @db.Decimal(10, 2)
  freteSubsidiado    Decimal  @default(0) @map("frete_subsidiado") @db.Decimal(10, 2)

  canal CanalVenda @relation(fields: [canalId], references: [id], onDelete: Cascade)

  @@index([canalId])
  @@map("faixas_taxa_canal")
}

// ═══════════════════════ Fase 4 — o que o processo pedia ═══════════════════════

/// UMA FORNADA.
///
/// Queima não é etapa por onde a peça passa sozinha: é um evento em lote que
/// junta peças de vários lotes, ocupa um volume fixo e trava o forno por ~2
/// dias entre aquecer, queimar e esfriar. Modelar como etapa comum escondia
/// três coisas: quando fica pronto, se cabe, e o maior risco de perda do
/// ateliê (uma fornada de esmalte ruim leva a carga inteira).
///
/// A consequência que mais vale: peça não espera o forno, espera o forno
/// ENCHER. Daí sai a sugestão que nenhum ateliê calcula de cabeça —
/// "faltam 12 para fechar a carga; produzir essas 12 adianta as outras 68".
model Queima {
  id          String    @id @default(uuid()) @db.Uuid
  /// código curto para falar em voz alta: Q-0007
  codigo      String    @unique
  /// biscoito | esmalte
  tipo        String
  /// planejada | carregando | queimando | concluida | cancelada
  status      String    @default("planejada")
  fornoId     String?   @map("forno_id") @db.Uuid
  /// cópia da capacidade do forno no momento em que a fornada foi aberta —
  /// se a Vera trocar de forno depois, o histórico não muda de sentido
  capacidade  Int
  previstaPara DateTime? @map("prevista_para")
  iniciadaEm  DateTime? @map("iniciada_em")
  concluidaEm DateTime? @map("concluida_em")
  observacao  String?
  criadoEm    DateTime  @default(now()) @map("criado_em")

  forno Responsavel? @relation(fields: [fornoId], references: [id])
  itens QueimaItem[]

  @@index([status])
  @@map("queimas")
}

/// Quanto de cada lote entrou nesta fornada.
model QueimaItem {
  id         String @id @default(uuid()) @db.Uuid
  queimaId   String @map("queima_id") @db.Uuid
  loteId     String @map("lote_id") @db.Uuid
  quantidade Int
  /// De qual etapa de queima estas peças saíram.
  ///
  /// Opcional porque nulo é caso legítimo, não falta de dado: toda fornada
  /// aberta antes desta coluna existir não tem como saber, e a conclusão cai
  /// no caminho antigo — procurar a etapa de queima do roteiro. Preencher por
  /// trás seria chutar de qual pilha a carga saiu.
  etapaId    String? @map("etapa_id") @db.Uuid

  queima Queima @relation(fields: [queimaId], references: [id], onDelete: Cascade)
  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)
  etapa  Etapa? @relation(fields: [etapaId], references: [id])

  @@unique([queimaId, loteId])
  @@index([loteId])
  @@index([etapaId])
  @@map("queima_itens")
}

/// VENDA REALIZADA.
///
/// O briefing pedia "comparar produção com vendas" e isto não existia. Sem
/// venda, `qtdMinimaDesejada` é um chute que a Vera dá uma vez e nunca revisa,
/// e todo o planejamento pende dele: o sistema respondia "estou fazendo o que
/// eu disse?" mas não "estou fazendo as coisas certas?".
///
/// Granularidade é o MÊS, de propósito. Mercado Livre e Shopee exportam
/// planilha mensal; exigir data exata por pedido só criaria trabalho de
/// digitação que ninguém faz. O que o planejamento precisa é tendência.
model Venda {
  id          String   @id @default(uuid()) @db.Uuid
  pecaId      String   @map("peca_id") @db.Uuid
  corId       String?  @map("cor_id") @db.Uuid
  canalId     String?  @map("canal_id") @db.Uuid
  /// AAAA-MM — o mês de competência
  competencia String
  quantidade  Int
  /// Quantas destas o cliente devolveu (Mercado Livre, Shopee, troca).
  ///
  /// Coluna própria, e não desconto direto em `quantidade`, porque as duas
  /// perguntas são diferentes: "quanto saiu" responde pelo giro do anúncio,
  /// "quanto ficou" responde pela demanda real. Baixar `quantidade` apagaria a
  /// primeira, e com ela a única forma de medir taxa de devolução por canal —
  /// que num marketplace é o número que decide se o anúncio vale a pena.
  ///
  /// O LÍQUIDO (`quantidade - devolvidas`) é o que alimenta o comparativo e a
  /// cobertura: contar a peça devolvida como vendida faria o planejamento
  /// produzir para uma demanda que não existe.
  devolvidas  Int      @default(0)
  valorTotal  Decimal? @map("valor_total") @db.Decimal(12, 2)
  /// manual | importacao
  origem      String   @default("manual")
  criadoEm    DateTime @default(now()) @map("criado_em")

  peca  Peca        @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  cor   Cor?        @relation(fields: [corId], references: [id])
  canal CanalVenda? @relation(fields: [canalId], references: [id])

  /// uma linha por peça+cor+canal+mês: reimportar a mesma planilha corrige
  /// em vez de duplicar
  @@unique([pecaId, corId, canalId, competencia])
  @@index([competencia])
  @@map("vendas")
}

/// ENCOMENDA COM PRAZO.
///
/// Não estava no briefing. Um jogo sob medida tem data e prioridade, e disputa
/// o MESMO forno com a produção de estoque. Sem estar no sistema, encomenda
/// vira post-it na parede que fura a fila sem ninguém saber por quê.
model Encomenda {
  id          String    @id @default(uuid()) @db.Uuid
  codigo      String    @unique
  cliente     String
  contato     String?
  /// aberta | em_producao | pronta | entregue | cancelada
  status      String    @default("aberta")
  entregarAte DateTime? @map("entregar_ate") @db.Date
  observacao  String?
  criadoEm    DateTime  @default(now()) @map("criado_em")
  entregueEm  DateTime? @map("entregue_em")

  itens EncomendaItem[]
  lotes Lote[]

  @@index([status])
  @@map("encomendas")
}

model EncomendaItem {
  id          String @id @default(uuid()) @db.Uuid
  encomendaId String @map("encomenda_id") @db.Uuid
  pecaId      String @map("peca_id") @db.Uuid
  corId       String? @map("cor_id") @db.Uuid
  quantidade  Int

  encomenda Encomenda @relation(fields: [encomendaId], references: [id], onDelete: Cascade)
  peca      Peca      @relation(fields: [pecaId], references: [id])
  cor       Cor?      @relation(fields: [corId], references: [id])

  @@index([encomendaId])
  @@map("encomenda_itens")
}
