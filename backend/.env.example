# Neon — conexão POOLED (com -pooler): usada em runtime
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.us-east-1.aws.neon.tech/producao_vf?sslmode=require"
# Neon — conexão DIRETA (sem -pooler): usada pelas migrations.
# O advisory lock do prisma migrate não sobrevive ao PgBouncer e estoura P1002.
DIRECT_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/producao_vf?sslmode=require"

JWT_SECRET="troque-por-um-segredo-longo"
CORS_ORIGIN="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Usado só por `npm test` (banco local, nunca o de produção)
DATABASE_URL_TESTE="postgresql://postgres@localhost:5432/producao_vf_teste?schema=public"
